{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./lint/logic-layout.js",
    "./lint/persistence.js",
    "./lint/mainstream.js",
    "./lint/structure.js"
  ],
  "rules": {
    "func-style": [
      "error",
      "expression"
    ],
    "logic-layout/comment-run": "error",
    "logic-layout/result-only": "error",
    "persistence/settings-only": "error",
    "structure/import-direction": "error",
    "structure/engine-in-register": "error",
    "structure/generic-name": "error",
    "structure/tool-export": "error"
  },
  "overrides": [
    {
      "files": [
        "**/logic/**"
      ],
      "rules": {
        "logic-layout/exports": "error",
        "logic-layout/sections": "error",
        "logic-layout/placement": "error",
        "logic-layout/interface-forward": "error",
        "logic-layout/io-only": "error",
        "logic-layout/one-expression": "error",
        "logic-layout/rule-comment": "error",
        "no-unused-vars": [
          "error",
          {
            "ignoreRestSiblings": true
          }
        ],
        "complexity": [
          "error",
          {
            "max": 5
          }
        ],
        "max-lines": [
          "error",
          {
            "max": 70
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 15,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-depth": [
          "error",
          {
            "max": 2
          }
        ],
        "max-params": [
          "error",
          {
            "max": 3
          }
        ]
      }
    },
    {
      "files": [
        "**/hooks/register.tsx",
        "**/hook/**"
      ],
      "rules": {
        "mainstream/no-context": "error",
        "mainstream/no-delay": "error"
      }
    },
    {
      "files": [
        "**/fleet/logic/result.ts"
      ],
      "rules": {
        "logic-layout/result-only": "off",
        "logic-layout/io-only": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/*.test.ts"
  ]
}
